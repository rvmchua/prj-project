@startuml

actor "Customer" as c1
participant "Banking Menu" as menu
participant "Auth Service" as login
participant "AccountService" as accSvc
participant "AccountDAOImpl" as accDAO
database MySQL as db

c1 -> menu : Select login account
Activate menu

menu -> login : login()
Activate login

login --> c1 : prompt "Enter account number"
c1 -> login : accountNumber
login --> c1 : prompt "Enter 4 digit PIN"
c1 -> login : pinCode

login -> accSvc : findAccountOrThrow(accountNumber)
Activate accSvc

accSvc -> accDAO : findByAccountNumber(accountNumber)
Activate accDAO

accDAO -> db : SELECT * FROM accounts WHERE account_number = ?
db --> accDAO : ResultSet (1 result)
accDAO --> accSvc : Optional<Account> [present]
Deactivate accDAO



@enduml