@startuml
title Banking App Database - Entity Relationship Diagram
skinparam linetype ortho
hide circle

entity "accounts" as accounts {
  * **entry_id** : INT(11) <<PK, AUTO_INCREMENT>>
  --
  * **account_number** : BIGINT(20) <<UK>>
  * first_name : VARCHAR(50)
  * last_name : VARCHAR(50)
  * pin_code : BIGINT(6)
  * balance : DECIMAL(15,2) = 0.00
  * created_at : DATETIME
  * updated_at : DATETIME
}

entity "transactions" as transactions {
  * **transaction_id** : BIGINT(20) <<PK, AUTO_INCREMENT>>
  --
  * **account_number** : BIGINT(20) <<FK>>
  * type : ENUM('WITHDRAW','DEPOSIT','TRANSFER')
  * amount : DECIMAL(15,2)
  * balance_after : DECIMAL(15,2)
  * created_at : DATETIME
}

accounts ||--o{ transactions : "1 : N (fk_transactions_accounts)"

@enduml